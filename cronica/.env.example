# Copie para .env (nunca é commitado) ou exporte no ambiente.

# Riot. A chave de DEV expira em 24h: a primeira coleta de 8 jogadores leva
# horas de rate limit, então vale pedir chave de produção antes de começar.
RIOT_API_KEY=

# Roteamento (o grupo joga no BR).
# RIOT_REGIONAL=americas
# RIOT_PLATFORM=br1

# LLM: basta estar logado (`claude` -> /login). Em CI, gere um token de 1 ano
# com `claude setup-token` e guarde como secret CLAUDE_CODE_OAUTH_TOKEN.
# NÃO defina ANTHROPIC_API_KEY: ela tem precedência sobre o token da assinatura.
# CRONICA_CLAUDE_MODEL=sonnet

# Caminhos (opcionais).
# CRONICA_BANCO=dados/fatos.db
# CRONICA_DIR_SAIDA=saida
