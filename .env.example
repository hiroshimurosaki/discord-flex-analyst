# Copie para .env e preencha. O .env NUNCA é commitado (ver .gitignore).
# Funciona igual em Linux e Windows.

# Riot API — chave de DEV expira em 24h; produção para rodar 24/7.
RIOT_API_KEY=COLE_SUA_CHAVE_AQUI

# LLM (Gemini — tier gratuito). Chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo da narrativa (default Flash — melhor custo-benefício).
GEMINI_MODEL=gemini-flash-latest

# Discord — token do bot e onde ele posta (plugado no marco "saída mínima").
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CANAL_ID=

# Caminho do banco (opcional). Default: ./data/bot_lol.db
# BOT_LOL_DB_PATH=
